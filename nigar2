 hud.idx.Text = ("TARGET %d OF %d"):format(AR2_specIdx, math.max(#list, 1))
 end
 local uid = t.player and t.player.UserId or nil
 if uid and hud.lastUser ~= uid then
 hud.lastUser = uid
 pcall(function()
 hud.avatar.Image =
 ("rbxthumb://type=AvatarHeadShot&id=%d&w=150&h=150"):format(uid)
