 local root = me and me:FindFirstChild("HumanoidRootPart")
 if not (cam and root) then return nil end
 local maxD = AR2_safeClamp(tonumber(AR2_CFG.nade.range) or 200, 20, 600)
 local best, bestScore = nil, math.huge
 for _, pl in ipairs(AR2_Players:GetPlayers()) do
 if pl ~= AR2_LocalPlayer then
 local c = pl.Character
 local r = c and c:FindFirstChild("HumanoidRootPart")
 local h = c and c:FindFirstChildOfClass("Humanoid")
 if r and h and h.Health > 0 then
