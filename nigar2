 if not AR2_3pAds.currentPos then AR2_3pAds.currentPos = safeTarget end
 AR2_3pAds.currentPos = AR2_3pAds.currentPos:Lerp(safeTarget, c.smooth)
 local aimPoint = charPos + ar2Look * 500
