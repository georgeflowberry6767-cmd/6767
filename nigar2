function AR2_browserSpinAdd(vp, cam, center, radius)
 AR2_browserSpins[#AR2_browserSpins + 1] =
 { vp = vp, cam = cam, c = center, r = radius,
 phase = (#AR2_browserSpins % 8) * 0.4 }
 if AR2_browserSpinConn then return end
 AR2_browserSpinConn = AR2_RunService.Heartbeat:Connect(AR2_sw(function(dt)
 if not (AR2_browser and AR2_browser.gui) then return end
 AR2_browserSpinT = AR2_browserSpinT + (dt or 0.016)
 local keep = {}
 for _, e in ipairs(AR2_browserSpins) do
 if e.vp and e.vp.Parent and e.cam then
 keep[#keep + 1] = e
 local a = AR2_browserSpinT * 0.9 + e.phase
 local p = e.c + Vector3.new(math.sin(a) * e.r, e.r * 0.35, math.cos(a) * e.r)
 pcall(function() e.cam.CFrame = CFrame.new(p, e.c) end)
 end
 end
 AR2_browserSpins = keep
 end))
end
function AR2_browserSpinClear()
 AR2_browserSpins = {}
 if AR2_browserSpinConn then
 AR2_browserSpinConn:Disconnect()
 AR2_browserSpinConn = nil
 end
end
