 pcall(AR2_noclipSitStates, wantSit)
 end
 if wantSit and not h.Sit then pcall(function() h.Sit = true end) end
 if (not wantSit) and h.Sit then pcall(function() h.Sit = false end) end
 h.PlatformStand = true
 noclipSetCollision(ch, false)
 local UIS  = AR2_UserInputService
 local cam  = AR2_Workspace.CurrentCamera
 local move = Vector3.zero
 if UIS:IsKeyDown(Enum.KeyCode.W) then move = move + (cam.CFrame.LookVector) end
 if UIS:IsKeyDown(Enum.KeyCode.S) then move = move - (cam.CFrame.LookVector) end
 if UIS:IsKeyDown(Enum.KeyCode.D) then move = move + (cam.CFrame.RightVector) end
 if UIS:IsKeyDown(Enum.KeyCode.A) then move = move - (cam.CFrame.RightVector) end
 if UIS:IsKeyDown(Enum.KeyCode.Space) then move = move + (Vector3.new(0, 1, 0)) end
 if UIS:IsKeyDown(Enum.KeyCode.LeftControl)
 or UIS:IsKeyDown(Enum.KeyCode.RightControl)
 or UIS:IsKeyDown(Enum.KeyCode.Q)
 or UIS:IsKeyDown(Enum.KeyCode.LeftShift)
 or UIS:IsKeyDown(Enum.KeyCode.RightShift)
 then
 move = move - (Vector3.new(0, 1, 0))
 end
 if move.Magnitude < 0.001 then
 r.AssemblyLinearVelocity = Vector3.zero
 return
 end
 local step  = (tonumber(AR2_CFG.misc.noclipSpeed) or 90) * math.min(dt, 0.1)
 local delta = move.Unit * step
 if AR2_CFG.misc.noclipWalk ~= false then
 local flat = Vector3.new(delta.X, 0, delta.Z)
 local nextPos = r.Position + flat
 local params = RaycastParams.new()
 params.FilterType = Enum.RaycastFilterType.Exclude
 params.IgnoreWater = true
 local ig = {}
 local ch = AR2_LocalPlayer and AR2_LocalPlayer.Character
 if ch then ig[#ig + 1] = ch end
 if AR2_hbeFolder then ig[#ig + 1] = AR2_hbeFolder end
 params.FilterDescendantsInstances = ig
 local hit
 pcall(function()
 hit = AR2_Workspace:Raycast(nextPos + Vector3.new(0, 6, 0),
 Vector3.new(0, -40, 0), params)
 end)
 if hit then
 local wantY = hit.Position.Y + AR2_noclipHipHeight()
 nextPos = Vector3.new(nextPos.X,
 nextPos.Y + (wantY - nextPos.Y) * 0.35, nextPos.Z)
 end
 if math.abs(delta.Y) > 0.001 then
 nextPos = nextPos + Vector3.new(0, delta.Y, 0)
 end
 local moveDelta = nextPos - r.Position
 r.CFrame = r.CFrame - r.CFrame.Position + nextPos
 r.AssemblyLinearVelocity = (dt > 0) and (moveDelta / dt) or Vector3.zero
 else
 r.CFrame = r.CFrame + delta
 r.AssemblyLinearVelocity = (dt > 0) and (delta / dt) or Vector3.zero
 end
 end)
end
