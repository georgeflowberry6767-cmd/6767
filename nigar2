end
function AR2_screenBox(model, useWhitelist)
 local cam = Workspace.CurrentCamera
 if not cam then return nil end
 local parts = AR2_boxPartList(model, useWhitelist)
 if #parts == 0 then
 if useWhitelist then return AR2_screenBox(model, false) end
 return nil
 end
 local lo = Vector3.new(math.huge, math.huge, math.huge)
 local hi = Vector3.new(-math.huge, -math.huge, -math.huge)
 local any = false
 for i = 1, #parts do
 local part = parts[i]
 if part.Parent then
 local cf, sz = part.CFrame, part.Size
 local r, u, l = cf.RightVector, cf.UpVector, cf.LookVector
 local hx = math.abs(r.X) * sz.X + math.abs(u.X) * sz.Y + math.abs(l.X) * sz.Z
 local hy = math.abs(r.Y) * sz.X + math.abs(u.Y) * sz.Y + math.abs(l.Y) * sz.Z
 local hz = math.abs(r.Z) * sz.X + math.abs(u.Z) * sz.Y + math.abs(l.Z) * sz.Z
 local c = cf.Position
 local e = Vector3.new(hx, hy, hz) * 0.5
 local a1, b1 = c - e, c + e
 if a1.X < lo.X then lo = Vector3.new(a1.X, lo.Y, lo.Z) end
 if a1.Y < lo.Y then lo = Vector3.new(lo.X, a1.Y, lo.Z) end
 if a1.Z < lo.Z then lo = Vector3.new(lo.X, lo.Y, a1.Z) end
 if b1.X > hi.X then hi = Vector3.new(b1.X, hi.Y, hi.Z) end
 if b1.Y > hi.Y then hi = Vector3.new(hi.X, b1.Y, hi.Z) end
 if b1.Z > hi.Z then hi = Vector3.new(hi.X, hi.Y, b1.Z) end
 any = true
 end
 end
 if not any then
 AR2_boxParts[model] = nil
 if useWhitelist then return AR2_screenBox(model, false) end
 return nil
 end
 local mid  = (lo + hi) * 0.5
 local span = (hi - lo).Magnitude * 0.5
 if cam.CFrame:PointToObjectSpace(mid).Z > span then return nil end
 local minX, minY = math.huge, math.huge
 local maxX, maxY = -math.huge, -math.huge
 local onScreen = false
 for x = 0, 1 do for y = 0, 1 do for z = 0, 1 do
 local pt = cam:WorldToViewportPoint(Vector3.new(
 x == 0 and lo.X or hi.X,
 y == 0 and lo.Y or hi.Y,
 z == 0 and lo.Z or hi.Z))
 if pt.Z > 0 then
 onScreen = true
 if pt.X < minX then minX = pt.X end
 if pt.Y < minY then minY = pt.Y end
 if pt.X > maxX then maxX = pt.X end
 if pt.Y > maxY then maxY = pt.Y end
 end
 end end end
 if not onScreen or minX == math.huge then return nil end
 return minX, minY, maxX - minX, maxY - minY
end
function AR2_readEntityHealth(model)
 do
 local ok, attrs = pcall(function() return model:GetAttributes() end)
 if ok and type(attrs) == "table" then
 local h = attrs.Health or attrs.health or attrs.HP or attrs.CurrentHealth
 local m = attrs.MaxHealth or attrs.maxHealth or attrs.MaxHP
 if tonumber(h) then return tonumber(h), math.max(tonumber(m) or 100, 1) end
 end
 end
 local anim = model:FindFirstChild("Animator")
 if anim then
 local ok, attrs = pcall(function() return anim:GetAttributes() end)
 if ok and type(attrs) == "table" then
 local h = attrs.Health or attrs.HP or attrs.CurrentHealth
 local m = attrs.MaxHealth or attrs.MaxHP
 if tonumber(h) then return tonumber(h), math.max(tonumber(m) or 100, 1) end
 end
 end
 if anim then
 local hp  = anim:FindFirstChild("Health")
 local mhp = anim:FindFirstChild("MaxHealth")
 if hp and hp:IsA("ValueBase") then
 local h  = tonumber(hp.Value)
 local mh = (mhp and mhp:IsA("ValueBase") and tonumber(mhp.Value)) or 100
 if h then return h, math.max(mh, 1) end
 end
 end
 local humanoid = model:FindFirstChildWhichIsA("Humanoid")
 if humanoid then
 local h  = humanoid.Health
 local mh = humanoid.MaxHealth
 if type(h) == "number" and type(mh) == "number" and mh > 0 then return h, mh end
 end
 for _, d in ipairs(model:GetDescendants()) do
 if d:IsA("ValueBase") and (d.Name == "Health" or d.Name == "HP") then
 local h = tonumber(d.Value)
 if h then
 local mp = d.Parent and (d.Parent:FindFirstChild("MaxHealth")
 or d.Parent:FindFirstChild("MaxHP"))
 local m = (mp and mp:IsA("ValueBase") and tonumber(mp.Value)) or 100
 return h, math.max(m, 1)
 end
 end
 end
 return nil, nil
end
