function AR2_browserRender()
 local B = AR2_browser
 if not (B.gui and B.grid) then return end
 for _, c in ipairs(B.grid:GetChildren()) do
 if c:IsA("TextButton") then c:Destroy() end
 end
 local list = AR2_browserList(B.kind, B.group, B.filter)
 local pages = math.max(1, math.ceil(#list / AR2_BROWSER_PER_PAGE))
 if B.page > pages then B.page = pages end
 if B.page < 1 then B.page = 1 end
 local from = (B.page - 1) * AR2_BROWSER_PER_PAGE + 1
 local to = math.min(#list, from + AR2_BROWSER_PER_PAGE - 1)
 pcall(AR2_browserSpinClear)
 B.renderToken = (B.renderToken or 0) + 1
 local token = B.renderToken
 local kind = B.kind
 task.spawn(function()
 local n = 0
 for i = from, to do
 if B.renderToken ~= token or not (B.gui and B.grid) then return end
 AR2_browserTile(B.grid, list[i], kind)
 n = n + 1
 if n % 4 == 0 then task.wait() end
 end
 end)
 if B.pageLbl then
 B.pageLbl.Text = ("%d-%d of %d   (page %d/%d)")
 :format(#list > 0 and from or 0, to, #list, B.page, pages)
 end
end
function AR2_browserClose()
 local B = AR2_browser
