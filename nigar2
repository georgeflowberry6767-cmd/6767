do
 local _ar2_origBuildUI = AR2_buildUI
 function AR2_buildUI(...)
  local _pr = table.pack(pcall(_ar2_origBuildUI, ...))
  local _lines = {}
  if not _pr[1] then
   _lines[#_lines+1] = "BUILD THREW: " .. tostring(_pr[2])
  end
  _lines[#_lines+1] = "sections built (" .. tostring(#(AR2_uiTrace or {})) .. "): "
   .. table.concat(AR2_uiTrace or {}, ", ")
  if #(AR2_uiErrors or {}) > 0 then
   _lines[#_lines+1] = "row errors:"
   for _, e in ipairs(AR2_uiErrors) do _lines[#_lines+1] = "  " .. tostring(e) end
  end
  local _rep = table.concat(_lines, "\n")
  warn("[YVL UI REPORT]\n" .. _rep)
  pcall(function() setclipboard(_rep) end)
  local r = _pr[1] and table.pack(table.unpack(_pr, 2, _pr.n)) or table.pack()
  task.defer(function()
   pcall(function() if AR2_CFG.ui.bar ~= false then AR2_openBar() end end)
   pcall(AR2_addWindowGrip)
   pcall(AR2_debrandSweep)
  end)
  return table.unpack(r, 1, r.n)
 end
end
