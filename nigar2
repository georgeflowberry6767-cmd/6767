 table.sort(pick, function(a, b) return a.distance < b.distance end)
 local used = 0
 for _, e in ipairs(pick) do
 if used >= maxPan then break end
 local anchor = e.head or e.root
 if anchor then
 local sp, on = cam:WorldToViewportPoint(anchor.Position)
 if on and sp.Z > 0 then
 local rows = buildRows(e, c)
 if #rows > 0 then
 used = used + 1
 local pn = panel(used)
 local isEvt = e.isEvent or e.isUnique
 local rare  = isEvt
 or (e.rarity ~= nil and e.rarity <= (tonumber(c.rareBelow) or 0.3))
 local title = tostring(e.label or e.name or "?")
 local meta  = e.isEvent and "EVENT"
 or (e.isUnique and "UNIQUE")
 or (("%dm"):format(math.floor(e.distance)))
 pn.title.Text = title
 pn.title.Color = rare and ACCENT or TEXT
 pn.meta.Text  = meta
 pn.meta.Color = rare and ACCENT or DIM
 local w = widthOf(pn.title, title, T_SIZE)
 + widthOf(pn.meta, meta, R_SIZE) + 14
 for i, rw in ipairs(rows) do
