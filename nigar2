function AR2_lrcParse(text)
 local out = {}
 for line in tostring(text):gmatch("[^\n]+") do
 local m, s, cs, body = line:match("^%[(%d+):(%d+)%.(%d+)%](.*)$")
 if m then
 local t = tonumber(m) * 60 + tonumber(s) + tonumber("0." .. cs)
 body = body:gsub("^%s+", ""):gsub("%s+$", "")
 out[#out + 1] = { t = t, s = body }
 end
 end
 table.sort(out, function(a, b) return a.t < b.t end)
 return out
end
