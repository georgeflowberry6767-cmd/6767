function AR2_tracerSimPath(origin, dir)
 if typeof(origin) ~= "Vector3" or typeof(dir) ~= "Vector3" then return nil end
 if dir.Magnitude < 1e-4 then return nil end
 local speed = nil
 pcall(function() speed = AR2_getBulletSpeed() end)
 if type(speed) ~= "number" or speed <= 0 then speed = 1000 end
 local g = 0
 pcall(function() g = AR2_getBulletGravity() or 0 end)
 if type(g) ~= "number" or g < 0 then g = 0 end
 local range = AR2_safeClamp(tonumber(AR2_CFG.misc.tracerPathRange) or 900, 50, 5000)
 local segs  = AR2_safeClamp(math.floor(tonumber(AR2_CFG.misc.tracerPathSegs) or 20), 4, 40)
 local dt    = (range / speed) / segs
 local params = AR2_tracerSimParams()
 local stopAt = AR2_CFG.misc.tracerPathImpact
 local sc = nil
 pcall(function() sc = AR2_getSpeedChange() end)
 local pos = origin
 local vel = dir.Unit * speed
 local pts = { pos }
 for _ = 1, segs do
 local nextVel = vel - Vector3.new(0, g, 0) * dt
 if sc then
 local sp = nextVel.Magnitude
 local newSp = AR2_applySpeedChange(sp, sc, dt)
 if sp > 1e-4 and newSp > 0 then nextVel = nextVel.Unit * newSp end
 end
 local seg = (vel + nextVel) * 0.5 * dt
 if seg.Magnitude < 0.01 then break end
 if stopAt then
 local hit = nil
 pcall(function() hit = AR2_Workspace:Raycast(pos, seg, params) end)
 if hit then
 pts[#pts + 1] = hit.Position
 break
 end
 end
 pos = pos + seg
 vel = nextVel
 pts[#pts + 1] = pos
 end
 return pts
end
