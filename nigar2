 end
 w = AR2_safeClamp(w + PAD * 2, 96, 260)
 local h = TITLE_H + #rows * ROW_H + PAD * 2
 local x = sp.X + 24
 if x + w > cam.ViewportSize.X - 4 then x = sp.X - w - 24 end
 x = math.max(4, x)
 local y = AR2_safeClamp(sp.Y - h / 2, 4, cam.ViewportSize.Y - h - 4)
 x, y = math.floor(x), math.floor(y)
 pn.bg.Size = Vector2.new(w, h)
 pn.bg.Position = Vector2.new(x, y)
 pn.bg.Visible = true
 pn.br.Size = Vector2.new(w, h)
 pn.br.Position = Vector2.new(x, y)
 pn.br.Visible = true
 pn.ac.Size = Vector2.new(2, h)
 pn.ac.Position = Vector2.new(x, y)
 pn.ac.Visible = true
 pn.title.Position = Vector2.new(x + PAD + 3, y + PAD - 2)
 pn.title.Visible = true
 pn.meta.Position = Vector2.new(
 x + w - PAD - widthOf(pn.meta, meta, R_SIZE), y + PAD - 1)
 pn.meta.Visible = true
 for i, rw in ipairs(rows) do
 local r = row(pn, i)
 local ry = y + PAD + TITLE_H + (i - 1) * ROW_H - 2
 r.name.Color = rw.col
 r.name.Position = Vector2.new(x + PAD + 3, ry)
