 local P = AR2_purchasesLib()
 if P and type(AR2_skinOrigGetSkins) == "function" then
 local ok, real = pcall(AR2_skinOrigGetSkins, P)
 if ok and type(real) == "table" then
 for _, v in pairs(real) do
 if type(v) == "table" and v.Id then
 owned[v.Id]  = true
 list[#list+1] = v
 end
 end
 end
 end
 local folder = AR2_skinFolder()
 if folder then
 local base, n = os.time(), 0
 local seen = {}
 local function take(d)
 local nm = d.Name
 if nm == "" or seen[nm] or owned[nm] then return end
 seen[nm] = true
 n = n + 1
 list[#list+1] = { Id = nm,
 Config = { Timestamp = base - n, Favorite = false } }
 end
 for _, d in ipairs(folder:GetDescendants()) do
 if d:IsA("ModuleScript") then take(d) end
 end
 if n <= 8 then
 for _, d in ipairs(folder:GetChildren()) do
 if not d:IsA("Folder") then take(d) end
 end
 end
 end
 if #list > 0 then AR2_skinList = list end
 return list
end
function AR2_skinFindItem(itemId)
 local found
 pcall(function()
 local gc  = AR2_resolveGameCharacter()
 local inv = gc and rawget(gc, "Inventory")
 if type(inv) ~= "table" then return end
 local function check(it)
 if found or type(it) ~= "table" then return end
 local ok, id = pcall(function() return it.Id end)
 if ok and id == itemId then found = it end
 end
 for _, v in pairs(rawget(inv, "Equipment") or {}) do
 if type(v) == "table" then
 local sub = rawget(v, "Items")
 if type(sub) == "table" then
 for _, it in pairs(sub) do check(it) end
 else
 check(v)
 end
 end
 end
 for _, c in pairs(rawget(inv, "Containers") or {}) do
 if type(c) == "table" then
 for _, it in pairs(rawget(c, "Occupants") or {}) do check(it) end
 end
 end
 end)
 return found
end
function AR2_paintLocal(itemId, skinId)
 skinId = tostring(skinId or "")
 local it = AR2_skinFindItem(itemId)
 if not it then return false, "item not found" end
 local ok = pcall(function() it.SkinId = skinId end)
 if not ok then
 local inner = rawget(it, "__item")
 if type(inner) == "table" then
 pcall(function() inner.SkinId = skinId end)
 end
 end
 local now = ""
 pcall(function() now = tostring(it.SkinId) end)
 if now == skinId and type(AR2_skinWanted) == "table" then
 AR2_skinWanted[itemId] = skinId
 end
 AR2_skinRefreshed = false
 pcall(function()
 local gc = AR2_resolveGameCharacter()
 local an = gc and rawget(gc, "Animator")
 if an == nil and type(gc) == "table" then an = gc.Animator end
 if an and type(an.RunAction) == "function" then
 an:RunAction("Refresh Tool Data")
 AR2_skinRefreshed = true
 end
 end)
 return now == skinId, now
end
