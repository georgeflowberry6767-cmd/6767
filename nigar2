 for _, it in ipairs(items) do
 local ok = true
 if AR2_CFG.lootFilterOn then
 local ty = AR2_itemType(it)
 if type(ty) == "string" then
 AR2_lootTypeSeen[ty] = (AR2_lootTypeSeen[ty] or 0) + 1
 if AR2_CFG.lootTypes[ty] == false then
 ok = false
