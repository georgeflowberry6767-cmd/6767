function AR2_fitWear(name, sub)
 local slot = AR2_fitSlotOf(name)
 if not slot then return false, "no slot for " .. tostring(name) end
 AR2_fitWorn = AR2_fitWorn or {}
 if AR2_MULTI_SLOTS[slot] and (sub == nil or tostring(sub) == "") then
 local taken = {}
 for _, rec in pairs(AR2_fitWorn) do
 if rec.slot == slot and rec.name ~= "Default" then
 taken[tostring(rec.sub or 1)] = rec.name
 end
 end
 if taken["1"] == name then sub = "1"
 elseif taken["2"] == name then sub = "2"
 elseif taken["1"] == nil then sub = "1"
 elseif taken["2"] == nil then sub = "2"
 else sub = "1" end
 end
 AR2_fitWorn[AR2_fitKey(slot, sub)] = { slot = slot, sub = sub, name = name }
 local ok, info = AR2_fitRedress()
 if not ok then
 return false, ("dress failed: %s (Cosmetics -> Why Is Dress Not Working)")
 :format(tostring(AR2_fitLastErr or info))
 end
 return true, slot
end
