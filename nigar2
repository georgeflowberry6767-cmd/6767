function AR2_bagIsBagName(n)
 local l = string.lower(tostring(n))
 for _, w in ipairs(AR2_BAG_NOT) do
 if string.find(l, w, 1, true) then return false end
 end
 for _, w in ipairs(AR2_BAG_WORDS) do
 if string.find(l, w, 1, true) then return true end
 end
