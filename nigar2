 end
 local cam = AR2_Workspace.CurrentCamera
 if not cam then return end
 local gc = AR2_resolveGameCharacter and AR2_resolveGameCharacter()
 if not gc then return end
 local suspend = AR2_aaSuspended()
 local _, camYaw = cam.CFrame:ToOrientation()
 local yaw   = math.rad(AR2_aaYawDeg(math.deg(camYaw)))
 local pitch = math.rad(AR2_aaPitchDeg())
 if c.hrp then
 local ch   = AR2_LocalPlayer and AR2_LocalPlayer.Character
 local root = ch and ch:FindFirstChild("HumanoidRootPart")
 local hum  = ch and ch:FindFirstChildOfClass("Humanoid")
 if root and hum then
 if suspend then
 if AR2_aaAutoRotWas ~= nil then
 pcall(function() hum.AutoRotate = AR2_aaAutoRotWas end)
 AR2_aaAutoRotWas = nil
 end
 else
 if AR2_aaAutoRotWas == nil then
 pcall(function() AR2_aaAutoRotWas = hum.AutoRotate end)
 end
 pcall(function()
 hum.AutoRotate = false
 root.CFrame = CFrame.new(root.Position) * CFrame.Angles(0, yaw, 0)
 end)
 end
 end
 end
 if c.orbit and not suspend then
 local ch   = AR2_LocalPlayer and AR2_LocalPlayer.Character
