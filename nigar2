function AR2_urlEnc(s)
 return (tostring(s):gsub("[^%w%-%._~]", function(c)
 return ("%%%02X"):format(string.byte(c))
 end))
end
function AR2_spotAuthUrl()
 local id = tostring(AR2_CFG.ui.spotifyId or "")
 if id == "" then return nil, "enter the Client ID first" end
 return ("https://accounts.spotify.com/authorize?client_id=%s"
 .. "&response_type=code&redirect_uri=%s&scope=%s")
 :format(AR2_urlEnc(id), AR2_urlEnc(AR2_SPOT_REDIRECT),
 AR2_urlEnc(AR2_SPOT_SCOPES))
end
function AR2_spotExchangeCode(raw)
 local req = AR2_httpFn()
 if not req then return false, "no http request function" end
 local id = tostring(AR2_CFG.ui.spotifyId or "")
 local sec = tostring(AR2_CFG.ui.spotifySecret or "")
 if id == "" or sec == "" then return false, "need Client ID and Secret" end
 local code = tostring(raw or ""):gsub("^%s+", ""):gsub("%s+$", "")
 local inUrl = code:match("[?&]code=([^&%s]+)")
 if inUrl then code = inUrl end
 if code == "" then return false, "paste the code from the address bar" end
 local body = ("grant_type=authorization_code&code=%s&redirect_uri=%s")
 :format(AR2_urlEnc(code), AR2_urlEnc(AR2_SPOT_REDIRECT))
 local ok, res = pcall(req, {
 Url = "https://accounts.spotify.com/api/token",
 Method = "POST",
 Headers = {
 ["Authorization"] = "Basic " .. AR2_b64(id .. ":" .. sec),
 ["Content-Type"] = "application/x-www-form-urlencoded",
 },
 Body = body,
 })
 if not ok or type(res) ~= "table" then
 return false, "request failed: " .. tostring(res)
 end
 local b = tostring(res.Body or "")
 local rt = b:match('"refresh_token"%s*:%s*"([^"]+)"')
 if not rt then
 local why = b:match('"error_description"%s*:%s*"([^"]+)"')
 or b:match('"error"%s*:%s*"([^"]+)"')
 return false, why or ("no refresh_token (HTTP "
 .. tostring(res.StatusCode or "?") .. ")")
 end
 AR2_CFG.ui.spotifyRefresh = rt
 AR2_spotify.refreshToken = rt
 AR2_spotify.clientId     = id
 AR2_spotify.clientSecret = sec
 pcall(function() setclipboard(rt) end)
 return true, rt
end
