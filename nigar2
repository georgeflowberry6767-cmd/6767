function AR2_mouseSpoofSet(on)
 if not on then
 if AR2_mouseOrigGet and AR2_mouseHookHow == "hookfunction"
 and type(restorefunction) == "function" then
 pcall(restorefunction, AR2_mouseOrigGet)
 end
 AR2_mouseWhy = "off"
 return true, "off"
 end
 if AR2_mouseOrigGet then return true, "already hooked" end
 local orig = AR2_UserInputService.GetMouseLocation
 if type(orig) ~= "function" then
 AR2_mouseWhy = "GetMouseLocation unavailable"
 return false, AR2_mouseWhy
 end
 AR2_mouseOrigGet = orig
 local function wrapped(self, ...)
 local real = select(2, pcall(orig, self, ...))
 if typeof(real) ~= "Vector2" then real = Vector2.new(0, 0) end
 if not (AR2_CFG.misc and AR2_CFG.misc.mouseSpoof) then
 AR2_mouseWhy = "spoof off"
 return real
 end
 local okT, target = pcall(AR2_aimScreenPoint)
 if not okT or typeof(target) ~= "Vector2" then
 AR2_mouseReported = nil
 AR2_mouseWhy = "no locked target -- reporting the real cursor"
 return real
 end
 local a = AR2_safeClamp(tonumber(AR2_CFG.misc.mouseEase) or 0.25, 0.02, 1)
 local prev = AR2_mouseReported or real
 local nx = prev.X + (target.X - prev.X) * a
 local ny = prev.Y + (target.Y - prev.Y) * a
 AR2_mouseReported = Vector2.new(nx, ny)
 AR2_mouseSpoofs = AR2_mouseSpoofs + 1
 AR2_mouseWhy = "reporting the aim point"
 return AR2_mouseReported
 end
 local done = false
 if type(hookfunction) == "function" then
 local w = wrapped
 if type(newcclosure) == "function" then
 local okN, c = pcall(newcclosure, wrapped)
 if okN and type(c) == "function" then w = c end
 end
 local ok, ret = pcall(hookfunction, orig, w)
 if ok then
 if type(ret) == "function" then AR2_mouseOrigGet = ret end
 done = true
 AR2_mouseHookHow = "hookfunction"
 end
 end
 if not done then
 AR2_mouseOrigGet = nil
 AR2_mouseHookHow = "failed"
 AR2_mouseWhy = "no hookfunction -- cannot change what syncOut reads"
 return false, AR2_mouseWhy
 end
 AR2_mouseWhy = "hooked via " .. AR2_mouseHookHow
 return true, AR2_mouseWhy
end
