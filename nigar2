function AR2_freecamNative(on)
 local Cameras = AR2_camerasLib()
 if type(Cameras) ~= "table" then return false end
 AR2_installCameraHook()
 if AR2_FREECAM_NATIVE_AVAILABLE == nil then
 local okc, cam = pcall(function() return Cameras:GetCamera("FreeCam") end)
 AR2_FREECAM_NATIVE_AVAILABLE = (okc and type(cam) == "table") or false
 if not AR2_FREECAM_NATIVE_AVAILABLE then
 AR2_warnOnce("nofreecam",
 "[camera] this client has no FreeCam camera -- using the hub's "
 .. "own flyer (the camera RESTORE still goes through the game)", 5)
 end
 end
 if not AR2_FREECAM_NATIVE_AVAILABLE then return false end
 if on then
 local okCam = pcall(function()
 local fc = Cameras:GetCamera("FreeCam")
 if type(fc) ~= "table" then error("no FreeCam") end
 pcall(function()
 local uv = AR2_CAP.getupvalue and debug.getupvalue(fc.Step, 2)
 if type(uv) == "table" and uv.Position and uv.Position.Spring then
 uv.Position.Spring:SnapTo(AR2_Workspace.CurrentCamera.CFrame.Position, 1)
 end
 end)
 Cameras:SetCurrent("FreeCam")
 end)
 if okCam then AR2_fcNative = true end
 return okCam
 end
 if not AR2_fcNative then return false end
 AR2_fcNative = false
 return AR2_camNativeRestore(AR2_camRealName ~= "FreeCam" and AR2_camRealName or "Character")
end
function AR2_freecamSet(on)
 on = on and true or false
 AR2_CFG.misc.freecam = on
 if on == AR2_fcOn then return end
 AR2_fcOn = on
 if AR2_CFG.misc.freecamDesync ~= false then
 AR2_desyncFollow = nil
 AR2_desyncHide   = on
 AR2_desyncSet(on)
 return
 end
 if AR2_CFG.misc.freecamNative ~= false then
 if AR2_freecamNative(on) then return end
 if not on and AR2_fcNative == false and AR2_fcConn == nil then return end
 end
 local cam = AR2_Workspace.CurrentCamera
 if not cam then AR2_fcOn = false return end
 local CAS = game:GetService("ContextActionService")
 if not on then
 if AR2_fcConn then pcall(function() AR2_fcConn:Disconnect() end) AR2_fcConn = nil end
 if AR2_fcInputs then
 for _, c in ipairs(AR2_fcInputs) do pcall(function() c:Disconnect() end) end
 AR2_fcInputs = nil
 end
 pcall(function() CAS:UnbindAction(AR2_FC_ACTION) end)
 AR2_camRestore()
 return
 end
 AR2_fcCF = cam.CFrame
 AR2_camSave()
 pcall(function()
 CAS:BindActionAtPriority(AR2_FC_ACTION,
 function() return Enum.ContextActionResult.Sink end,
 false, Enum.ContextActionPriority.High.Value,
 table.unpack(AR2_FC_SINK_KEYS))
 end)
 local yaw, pitch = 0, 0
 do
 local lv = AR2_fcCF.LookVector
 yaw   = math.atan2(-lv.X, -lv.Z)
 pitch = math.asin(AR2_safeClamp(lv.Y, -1, 1))
 end
 AR2_fcInputs = {}
 AR2_fcInputs[#AR2_fcInputs + 1] = AR2_UserInputService.InputChanged:Connect(AR2_sw(function(i, gpe)
 if gpe then return end
 if i.UserInputType == Enum.UserInputType.MouseWheel then
 local sp = (tonumber(AR2_CFG.misc.freecamSpeed) or 60) + i.Position.Z * 10
 AR2_CFG.misc.freecamSpeed = AR2_safeClamp(sp, 5, 500)
 end
 end))
 AR2_fcConn = AR2_RunService.RenderStepped:Connect(function(dt)
 if not AR2_fcOn then return end
 local c = AR2_Workspace.CurrentCamera
 if not c then return end
 AR2_camHoldMouse()
 local d = AR2_UserInputService:GetMouseDelta()
 yaw   = yaw - d.X * 0.0045
 pitch = AR2_safeClamp(pitch - d.Y * 0.0045, -1.5, 1.5)
 local rot = CFrame.fromEulerAnglesYXZ(pitch, yaw, 0)
 local speed = tonumber(AR2_CFG.misc.freecamSpeed) or 60
 if AR2_UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then speed = speed * 3 end
 local move = Vector3.new(0, 0, 0)
 if AR2_UserInputService:IsKeyDown(Enum.KeyCode.W) then move = move + Vector3.new(0, 0, -1) end
 if AR2_UserInputService:IsKeyDown(Enum.KeyCode.S) then move = move + Vector3.new(0, 0,  1) end
 if AR2_UserInputService:IsKeyDown(Enum.KeyCode.A) then move = move + Vector3.new(-1, 0, 0) end
 if AR2_UserInputService:IsKeyDown(Enum.KeyCode.D) then move = move + Vector3.new( 1, 0, 0) end
 local vert = 0
 if AR2_UserInputService:IsKeyDown(Enum.KeyCode.Space) then vert = vert + 1 end
 if AR2_UserInputService:IsKeyDown(Enum.KeyCode.LeftControl)
 or AR2_UserInputService:IsKeyDown(Enum.KeyCode.Q) then vert = vert - 1 end
 local pos = AR2_fcCF.Position
 if move.Magnitude > 0 then
 pos = pos + (rot * move.Unit) * speed * dt
 end
 pos = pos + Vector3.new(0, vert * speed * dt, 0)
 AR2_fcCF = CFrame.new(pos) * rot
 pcall(function() c.CFrame = AR2_fcCF end)
 end)
end
