 pcall(function() AR2_Camera.FieldOfView = AR2_3pAds.normalFOV or 70 end)
 end
 return
 end
 AR2_3pAds.idleRestored = false
 end
 local ar2Look = AR2_Camera.CFrame.LookVector
 pcall(function()
 local anim = ch:FindFirstChild("Animator")
 if anim then
 local fp = anim:FindFirstChild("FirstPerson")
 if fp and fp.Value then fp.Value = false end
 end
 end)
 if AR2_CFG.misc.thirdPersonADS.showBody ~= false then
 for _, d in ipairs(ch:GetDescendants()) do
 if d:IsA("BasePart") or d:IsA("Decal") or d:IsA("Texture") then
 if d.LocalTransparencyModifier ~= 0 then
 pcall(function() d.LocalTransparencyModifier = 0 end)
 end
 end
 end
 local vm = AR2_Camera:FindFirstChild("Viewmodel") or AR2_Camera:FindFirstChild("ViewModel")
 if vm and AR2_CFG.misc.thirdPersonADS.hideViewmodel then
 for _, d in ipairs(vm:GetDescendants()) do
 if d:IsA("BasePart") or d:IsA("Decal") then
 pcall(function() d.LocalTransparencyModifier = 1 end)
 end
 end
 end
 end
 local zoom    = AR2_3pAds.zoom or 0
 local baseFOV = c.adsFOV or 55
 local baseBk  = AR2_3pAds.baseBack or c.offsetBack or 3.5
 local wantFOV, wantBack
 if zoom >= 0 then
 local t  = AR2_safeClamp(zoom, 0, 1)
 wantFOV  = baseFOV + ((c.fovNear or 10) - baseFOV) * t
 wantBack = baseBk  + ((c.minBack or 0.5) - baseBk) * t
 else
 local t  = AR2_safeClamp(-zoom, 0, 1)
 wantFOV  = baseFOV + ((c.fovFar or 90) - baseFOV) * t
 wantBack = baseBk  + ((c.maxBack or 16) - baseBk) * t
 end
 c.offsetBack = wantBack
 AR2_Camera.FieldOfView = AR2_Camera.FieldOfView
 + (wantFOV - AR2_Camera.FieldOfView) * 0.2
 local flatLook = Vector3.new(ar2Look.X, 0, ar2Look.Z)
 if flatLook.Magnitude < 0.01 then flatLook = Vector3.new(0, 0, -1) end
 flatLook = flatLook.Unit
 local right   = flatLook:Cross(Vector3.new(0, 1, 0)).Unit
 local charPos = r.Position + Vector3.new(0, 1, 0)
