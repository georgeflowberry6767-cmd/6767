function AR2_themeGuiMaterials(gui)
 pcall(function()
 local S = AR2_skin()
 for _, d in ipairs(gui:GetDescendants()) do
 if d:IsA("Frame") and d.BackgroundTransparency < 0.9
 and not d:FindFirstChild("panelStroke")
 and d.AbsoluteSize.X > 90 and d.AbsoluteSize.Y > 40 then
 AR2_dressLikeWindow(d, S)
 local c = d:FindFirstChildWhichIsA("UICorner")
 if c then c.CornerRadius = UDim.new(0, S.radius) end
