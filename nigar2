function AR2_aaYawDeg(camYawDeg)
 local c = AR2_CFG.misc.antiAim
 local m = c.mode
 if m == "Spin" then
 return (os.clock() - AR2_aaT0) * (tonumber(c.spinSpeed) or 12) * 60 % 360
 elseif m == "Jitter" then
 local j = (tonumber(c.jitterDeg) or 145) / 2
 local phase = math.floor((os.clock() - AR2_aaT0) * 10) % 2
 return camYawDeg + 180 + (phase == 0 and -j or j)
 elseif m == "Static" then
 return tonumber(c.staticYaw) or 180
 end
 return camYawDeg + 180
end
function AR2_aaPitchDeg()
 local c = AR2_CFG.misc.antiAim
 local pm = c.pitch
 if not pm or pm == "Off" then return 0 end
 local d = tonumber(c.pitchDeg) or 89
 if pm == "Down" then return -d
 elseif pm == "Up" then return d
 elseif pm == "Fold" then return -89
 elseif pm == "Spin" then
 return math.sin((os.clock() - AR2_aaT0) * (tonumber(c.pitchSpeed) or 8)) * d
 end
 return -d
end
