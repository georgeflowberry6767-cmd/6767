 gunTxt = ti and ("%s  (%s)"):format(tostring(t.item), tostring(ti.t))
 or tostring(t.item)
 end
 hud.gun.Text = gunTxt
 hud.dist.Text = ("%d studs away"):format(
 math.floor((root.Position - myPos).Magnitude))
 if hud.mapImg and AR2_worldToMap then
 local tu, tv = AR2_worldToMap(root.Position)
 hud.tgtDot.Position = UDim2.fromScale(tu, tv)
 hud.tgtArrow.Position = UDim2.fromScale(tu, tv)
 local mu, mv = AR2_worldToMap(myPos)
 hud.myDot.Position = UDim2.fromScale(mu, mv)
 local vel  = root.AssemblyLinearVelocity
 local flat = Vector3.new(vel.X, 0, vel.Z)
 if flat.Magnitude > 1 then
 local deg = math.deg(math.atan2(flat.X, -flat.Z))
 hud.tgtArrow.Rotation = deg
 hud.tgtArrow.Visible = true
 if hud.heading then
 hud.heading.Rotation = deg
 hud.heading.Visible = true
 end
 else
 hud.tgtArrow.Visible = false
 if hud.heading then hud.heading.Visible = false end
 end
 if hud.mapFoot then
 hud.mapFoot.Text = ("X %d   Z %d"):format(
 math.floor(root.Position.X), math.floor(root.Position.Z))
 end
 end
 local vel = root.AssemblyLinearVelocity
 local flat = Vector3.new(vel.X, 0, vel.Z)
 local moveTxt
 if flat.Magnitude > 1 then
 moveTxt = ("moving %s  %.0f sps"):format(AR2_bearing(flat.Unit), flat.Magnitude)
 else
 moveTxt = "standing still"
 end
 local lv = root.CFrame.LookVector
 local toMe = myPos - root.Position
 if toMe.Magnitude > 1e-3 and lv.Unit:Dot(toMe.Unit) > 0.8 then
 moveTxt = moveTxt .. "  · FACING YOU"
 end
 hud.dir.Text = moveTxt
 local frac = 1
 pcall(function()
 local h = t.model and t.model:FindFirstChildOfClass("Humanoid")
 if h and h.MaxHealth > 0 then frac = AR2_safeClamp(h.Health / h.MaxHealth, 0, 1) end
 end)
 hud.hpFill.Size = UDim2.fromScale(frac, 1)
 hud.hpFill.BackgroundColor3 = (frac > 0.5) and Color3.fromRGB(226, 32, 44)
 or (frac > 0.25) and Color3.fromRGB(240, 160, 60)
 or Color3.fromRGB(255, 90, 90)
 if hud.hpTxt then
 hud.hpTxt.Text = ("HEALTH %d%%"):format(math.floor(frac * 100))
 end
 if hud.kd and hud.stats then
 if t.player then
 AR2_statsWant(t.player)
 local c = AR2_statsGet(t.player)
 if c then
 local k = tonumber(c.stats["Total Player Kills"]) or 0
 local d = tonumber(c.stats["Deaths"]) or 0
 hud.kd.Text = c.kd
 and ("K/D %.2f      %d kills / %d deaths"):format(c.kd, k, d)
 or "K/D --"
 local rows = {}
 for _, key in ipairs(AR2_STAT_ORDER) do
 if key ~= "Total Player Kills" and key ~= "Deaths" then
