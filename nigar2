function AR2_kbSyncAll()
 if AR2_kbPushUntil and os.clock() < AR2_kbPushUntil then return end
 for _, fn in ipairs(AR2_kbSync or {}) do pcall(fn) end
end
function AR2_kbPushAll()
 local n = 0
 AR2_uiSyncing = true
 AR2_kbPushUntil = os.clock() + 1.0
 for cfgKey, el in pairs(AR2_kbElems or {}) do
 local name = AR2_CFG.keybinds and AR2_CFG.keybinds[cfgKey]
 local v = nil
 if type(name) == "string" and name ~= "" and name ~= "None" then
 pcall(function() v = Enum.KeyCode[name] end)
 end
 if pcall(function() el:SetValue(v) end) then n = n + 1 end
 end
 AR2_uiSyncing = false
 return n
end
