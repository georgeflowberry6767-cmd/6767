function AR2_carController(model)
 model = model or AR2_carFlyModel or AR2_carFlyGetModel()
 if typeof(model) ~= "Instance" then return nil end
 local ok, cls = pcall(function() return AR2_fwGet("Classes", "VehicleControler") end)
 if not ok or type(cls) ~= "table" then
 pcall(function() cls = AR2_fwGet("Classes", "VehicleController") end)
 end
 if type(cls) ~= "table" then return nil end
 local get = rawget(cls, "get") or rawget(cls, "Get")
 if type(get) == "function" then
 local okG, c = pcall(get, cls, model)
 if okG and type(c) == "table" then return c end
 local okG2, c2 = pcall(get, model)
 if okG2 and type(c2) == "table" then return c2 end
 end
 return nil
end
function AR2_carStepSuppress(on)
 local c = AR2_carController()
 if type(c) ~= "table" then
 AR2_carStepWhy = "vehicle controller not reachable"
 return false, AR2_carStepWhy
 end
 local repaired = false
 if type(rawget(c, "IsControlling")) == "boolean" then
 pcall(function() c.IsControlling = nil end)
 repaired = true
 end
 if type(rawget(c, "Drivable")) == "function" then
 pcall(function() c.Drivable = nil end)
 repaired = true
 end
 if on then
 if not AR2_carStepSaved then
 local had = rawget(c, "IsControlling")
 AR2_carStepSaved = { had = had ~= nil, fn = had }
 end
 local ok = pcall(function() c.IsControlling = function() return false end end)
 AR2_carStepWhy = ok
 and ("IsControlling stubbed to return false -- Vehicle Step should stop "
 .. "writing Velocity and re-enabling motor limits"
 .. (repaired and " (also repaired a poisoned controller)" or ""))
 or "could not replace IsControlling"
 return ok, AR2_carStepWhy
 end
 if AR2_carStepSaved then
 pcall(function()
 if AR2_carStepSaved.had then
 c.IsControlling = AR2_carStepSaved.fn
 else
 c.IsControlling = nil
 end
 end)
 AR2_carStepSaved = nil
 end
 AR2_carStepWhy = repaired and "restored (and repaired a poisoned controller)"
 or "restored"
 return true, AR2_carStepWhy
end
function AR2_carFlyWhyNot()
