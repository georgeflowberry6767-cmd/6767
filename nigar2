 if AR2_drawEntity(e.model, color, c.name and e.displayName or nil, table.concat(bits, "  "), c) then
 counts.loot = counts.loot + 1
 drawn = drawn + 1
 end
 if c.chams and rank >= 4 then AR2_applyChams(e.model, color) end
 end
 end
 end
 if AR2_CFG.events.on and AR2_CFG.events.esp then
 local c = AR2_CFG.events
 local drawnEv = 0
 local capEv = AR2_safeClamp(tonumber(c.maxDrawn) or 12, 1, 40)
 for _, e in ipairs(AR2_api.events()) do
 if drawnEv >= capEv then break end
 if e.distance <= (tonumber(c.range) or 10000) then
 drawnEv = drawnEv + 1
 local txt = (e.count > 1)
 and ("EVENT %s x%d"):format(e.label, e.count)
 or  ("EVENT %s"):format(e.label)
 if e.model then
 AR2_drawEntity(e.model, c.color, txt,
 AR2_fmtDist(e.distance) .. "s", c)
 else
 AR2_drawWorldText(e.position, txt,
 AR2_fmtDist(e.distance) .. "s", c.color)
 end
 end
 end
 end
 AR2_drawWorldTextHide(AR2_worldTextUsed + 1)
 if AR2_CFG.items.on then
 local c = AR2_CFG.items
 local drawn = 0
 for _, e in ipairs(AR2_api.groundItems()) do
 if drawn >= 40 then break end
 if e.distance <= (c.maxDist or 2000) then
 local bits = {}
 if c.dist then bits[#bits+1] = AR2_fmtDist(e.distance) .. "s" end
 if AR2_drawEntity(e.model, c.color or AR2_COLORS.item,
 c.name and e.name or nil,
 table.concat(bits, "  "), c) then
 drawn = drawn + 1
 end
 end
 end
 end
 if AR2_CFG.vehicles.on or AR2_CFG.vehicles.chams then
 local c = AR2_CFG.vehicles
 for _, e in ipairs(AR2_api.vehicles()) do
 if e.distance <= c.maxDist then
 if c.on then
 local bits = {}
 if e.moving then bits[#bits+1] = "MOVING" end
 if c.dist then bits[#bits+1] = AR2_fmtDist(e.distance) .. "s" end
 if AR2_drawEntity(e.model, AR2_COLORS.vehicle, c.name and e.name or nil, table.concat(bits, "  "), c) then
 counts.vehicle = counts.vehicle + 1
 end
 end
 if c.chams then AR2_applyChams(e.model, AR2_COLORS.vehicle) end
 end
 end
 end
 if AR2_CFG.corpses.on then
 local c = AR2_CFG.corpses
 local drawn = 0
 local cap   = AR2_safeClamp(tonumber(c.maxDrawn) or 25, 1, 60)
 local pool = {}
 for _, e in ipairs(AR2_api.corpses()) do
 if e.distance <= (c.maxDist or 2000)
 and not (c.playersOnly and not e.isPlayer) then
 pool[#pool + 1] = e
 end
 end
 table.sort(pool, function(a, b) return a.distance < b.distance end)
 for _, e in ipairs(pool) do
 if drawn >= cap then break end
 do
 do
 local color = e.isGhost and Color3.fromRGB(120,120,130)
 or (e.isPlayer and Color3.fromRGB(255,170,60) or Color3.fromRGB(190,190,190))
 local bits = {}
 if e.isGhost then bits[#bits+1] = "last seen" end
 if c.dist then bits[#bits+1] = AR2_fmtDist(e.distance) .. "s" end
 if e.model then
 if AR2_drawEntity(e.model, color, c.name and e.name or nil,
 table.concat(bits, "  "), c) then
 counts.corpse = counts.corpse + 1
 drawn = drawn + 1
 end
 elseif e.position then
 if AR2_drawPoint(e.position, color, c.name and e.name or nil,
 table.concat(bits, "  "), c) then
 counts.corpse = counts.corpse + 1
 drawn = drawn + 1
 end
 end
 end
 end
 end
 end
 if AR2_CFG.drops and AR2_CFG.drops.on then
 local c = AR2_CFG.drops
 local drawn = 0
 local cap = AR2_safeClamp(tonumber(c.maxDrawn) or 20, 1, 60)
 for _, e in ipairs(AR2_api.drops(c.maxDist, c.allInteract)) do
 if drawn >= cap then break end
 local bits = {}
 if c.dist then bits[#bits + 1] = AR2_fmtDist(e.distance) .. "s" end
 if c.contents then
 if e.items and #e.items > 0 then
 local show = math.min(#e.items, 3)
 local parts = {}
 for i = 1, show do parts[i] = e.items[i] end
 bits[#bits + 1] = table.concat(parts, ", ")
 .. ((#e.items > show) and (" +" .. (#e.items - show)) or "")
 elseif #e.nodes > 0 then
 bits[#bits + 1] = AR2_lootNodeText(e.nodes, 3)
 end
 end
 local label = c.name and (e.useText or e.displayName) or nil
 local ok = false
 if e.model and e.model:IsA("Model") then
 ok = AR2_drawEntity(e.model, AR2_DROP_COLOR, label, table.concat(bits, "  "), c)
 elseif e.position then
 ok = AR2_drawPoint(e.position, AR2_DROP_COLOR, label, table.concat(bits, "  "), c)
 end
 if ok then
 counts.drop = counts.drop + 1
 drawn = drawn + 1
 end
 end
 end
 AR2_esp.counts = counts
 AR2_finishFrame()
end
