function AR2_zcfgFromDisk(name, depth)
 depth = (depth or 0) + 1
 if depth > 6 then return nil end
 local folder = AR2_zcfgFolder()
 if not folder then return nil end
 local mod = folder:FindFirstChild(name)
 if not mod or not mod:IsA("ModuleScript") then return nil end
 local ok, raw = pcall(require, mod)
 if not ok or type(raw) ~= "table" then return nil end
 local merged = {}
 if type(raw.Inherits) == "table" then
 for _, parent in ipairs(raw.Inherits) do
 local pc = type(parent) == "string" and AR2_zcfgFromDisk(parent, depth)
 if type(pc) == "table" then
 for k, v in pairs(pc) do merged[k] = v end
 end
 end
 end
 for k, v in pairs(raw) do merged[k] = v end
 return merged
end
