 if type(Cameras.LoadCamera) == "function" then Cameras:LoadCamera(name) end
 task.wait(0.1)
 Cameras:SetCurrent(name)
 end },
 { "Transition(" .. name .. ")", function()
 if Cameras and type(Cameras.Transition) == "function" then
