function AR2_applySpeedChange(speed, sc, dt)
 if type(sc) ~= "number" or type(speed) ~= "number" or type(dt) ~= "number" then
 return speed
 end
 if sc > 0 and sc < 1 then
 return speed * (sc ^ dt)
 elseif sc < 0 then
 return math.max(0, speed + sc * dt)
 end
 return speed
end
function AR2_getBulletSpeed()
 local c = AR2_CFG.magicAim
 local base, src
 if not c.autoSpeed and c.bulletSpeed and c.bulletSpeed > 0 then
 base, src = c.bulletSpeed, "manual override"
 AR2_speedVerified = true
 else
 local weaponName = AR2_getEquippedItemName()
 pcall(function()
 local liveId = AR2_equippedWeaponId and AR2_equippedWeaponId()
 local seed   = liveId and AR2_fireSeeds and AR2_fireSeeds[liveId]
 if seed then
 local v = AR2_muzzleOf(seed.wd)
 if v then base, src = v, "weaponData (seeded for this gun)" end
 end
 end)
 if not base then
 pcall(function()
 local v = AR2_lastFireParams and AR2_muzzleOf(AR2_lastFireParams.wd)
 if v then base, src = v, "weaponData (last shot)" end
 end)
 end
 if not base and weaponName then
 pcall(function()
 local ItemData = AR2_getItemDataModule()
 local v = ItemData and AR2_muzzleOf(ItemData[weaponName])
 if v then base, src = v, "ItemData[" .. weaponName .. "]" end
 end)
 end
 if base then
 AR2_speedVerified = true
 if weaponName then AR2_speedByWeapon[weaponName] = base end
 AR2_lastGoodSpeed = base
 else
 base = (weaponName and AR2_speedByWeapon[weaponName])
 or (weaponName and AR2_SPEED_FALLBACK[weaponName])
 or AR2_lastGoodSpeed or 4700
 src  = "FALLBACK (unverified" .. (weaponName and (": " .. weaponName) or "") .. ")"
 AR2_speedVerified = false
 end
 end
 AR2_speedSource = src
 if base then
 local mod = nil
 pcall(function()
 local fw = require(AR2_ReplicatedFirst:WaitForChild("Framework", 10))
 local G  = fw.require("Configs", "Globals") or fw.Configs.Globals
 if type(G) == "table" and type(G.MuzzleVelocityMod) == "number" then
 mod = G.MuzzleVelocityMod
 end
 end)
 if type(mod) == "number" and mod > 0 and mod ~= 1 then
 base = base * mod
 end
 AR2_velModUsed = mod or 1
 end
 if base then
 local nm2
 pcall(function() nm2 = AR2_getEquippedItemName and AR2_getEquippedItemName() end)
 local trueBase = AR2_ibOriginalSpeed and AR2_ibOriginalSpeed(nm2, base) or nil
 if type(trueBase) == "number" and trueBase > 0
 and math.abs(trueBase - base) > 1 then
 AR2_speedSource = ("%s | FC %.0f INFLATED -> %.0f")
 :format(tostring(AR2_speedSource), base, trueBase)
 base = trueBase
 end
 end
 if base and AR2_ibEnabled then
 local m = tonumber(AR2_ibEffectiveMult) or 1
 if m > 1 then
 if AR2_ibBoostedSpeed and AR2_ibSavedSpd
 and math.abs(base - AR2_ibSavedSpd) < 1 then
 base = AR2_ibBoostedSpeed
 else
 base = base * m
 end
 AR2_speedSource = (AR2_speedSource or "?") .. (" x%.2f insta"):format(m)
 end
 end
 local HARD = 60000
 if type(base) == "number" and (base ~= base or base > HARD or base <= 0) then
 local bad = base
 local fix = nil
 pcall(function()
 local nm = AR2_getEquippedItemName and AR2_getEquippedItemName()
 if nm and AR2_SPEED_TABLE then fix = AR2_SPEED_TABLE[nm] end
 end)
 if type(fix) ~= "number" or fix <= 0 then fix = 4000 end
 local cap = tonumber(AR2_CFG.weapon.ibMaxMult) or 3
 if AR2_ibEnabled then fix = fix * AR2_safeClamp(cap, 1, 20) end
 base = fix
 AR2_speedCorrupt = bad
 AR2_speedSource = ("CORRUPT %.0f -> fallback %.0f"):format(bad, fix)
 if not AR2_speedWarned or (os.clock() - AR2_speedWarned) > 10 then
 AR2_speedWarned = os.clock()
 warn(("[YVL] MuzzleVelocity is corrupt (%.0f). Using %.0f. "
 .. "Run Weapons > Reset Ballistics."):format(bad, fix))
 end
 end
 AR2_speedUsed = base
 return base
end
