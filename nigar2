function AR2_eventClusters(list, radius, minCount)
 local used, out = {}, {}
 for i, a in ipairs(list) do
 if not used[i] then
 used[i] = true
 local members = { a }
 local sum = a.position
 for j = i + 1, #list do
 local b = list[j]
 if not used[j] and (b.position - a.position).Magnitude <= radius then
 used[j] = true
 members[#members + 1] = b
 sum = sum + b.position
 end
 end
 if #members >= minCount then
 local tally, best, bestN = {}, nil, 0
 for _, m in ipairs(members) do
 local nm = tostring(m.label or m.name or "?")
 tally[nm] = (tally[nm] or 0) + 1
 if tally[nm] > bestN then best, bestN = nm, tally[nm] end
 end
 out[#out + 1] = {
 kind = "event",
 position = sum / #members,
 count = #members,
 label = best or "event",
 members = members,
 }
 end
 end
 end
 return out
end
