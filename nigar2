 if root and hum then
 if AR2_aaCenter == nil then AR2_aaCenter = root.Position end
 local md = hum.MoveDirection
 if md.Magnitude > 0.01 then
 AR2_aaCenter = AR2_aaCenter
 + md.Unit * (hum.WalkSpeed or 16) * (dt or 1 / 60)
 end
 local radius = AR2_safeClamp(tonumber(c.radius) or 4, 0.5, 20)
 local off
 if c.orbitMode == "Jitter" then
 local a = math.random() * math.pi * 2
 local d = math.random() * radius
 off = Vector3.new(math.cos(a) * d, 0, math.sin(a) * d)
 else
