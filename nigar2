 if v then rows[#rows + 1] = ("%s:  %s"):format(key, v) end
 end
 end
 hud.stats.Text = table.concat(rows, "\n")
 else
 hud.kd.Text = "K/D  —  fetching..."
 hud.stats.Text = ""
 end
 else
 hud.kd.Text = ""
 hud.stats.Text = ""
 end
 end
 end
 end)
