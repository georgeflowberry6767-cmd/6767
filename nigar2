 local L = {
 ("vehicle      : %s"):format(model and model.Name or "NOT SEATED / none found"),
 ("controller   : %s"):format(type(c) == "table" and "reachable" or "NOT reachable"),
 ("fly active   : %s"):format(tostring(AR2_carFlyActive)),
 ("BodyVelocity : %s"):format(tostring(AR2_carFlyBV ~= nil)),
 ("step suppress: %s"):format(tostring(AR2_carStepWhy)),
 ("IsControlling: %s  <- must be function or nil, NEVER boolean")
 :format(type(rawget(c or {}, "IsControlling"))),
 }
 if type(c) == "table" then
 for _, k in ipairs({ "Drivable", "IsControlling", "Braking", "BoatMode" }) do
 L[#L + 1] = ("  %-14s = %s"):format(k, tostring(rawget(c, k)))
 end
 end
 local out = table.concat(L, "\n")
 print("[YVL CAR]\n" .. out)
 pcall(function() setclipboard(out) end)
