function AR2_highGhostInput()
 if AR2_UserInputService:GetFocusedTextBox() then return nil end
 local cam = Workspace.CurrentCamera
 if not cam then return nil end
 local K = Enum.KeyCode
 local down = function(k) return AR2_UserInputService:IsKeyDown(k) end
 local look = cam.CFrame.LookVector
 local fwd
 if AR2_CFG.misc.ghostMode == "Fly" then
 fwd = (look.Magnitude > 0.01) and look.Unit or Vector3.new(0, 0, -1)
 else
 local flat = Vector3.new(look.X, 0, look.Z)
 fwd = (flat.Magnitude > 0.01) and flat.Unit or Vector3.new(0, 0, -1)
 end
 local flatFwd = Vector3.new(fwd.X, 0, fwd.Z)
 if flatFwd.Magnitude < 0.01 then flatFwd = Vector3.new(0, 0, -1) else flatFwd = flatFwd.Unit end
 local right = Vector3.new(-flatFwd.Z, 0, flatFwd.X)
 local dir = Vector3.zero
 if down(K.W) then dir = dir + fwd end
 if down(K.S) then dir = dir - fwd end
 if down(K.D) then dir = dir + right end
 if down(K.A) then dir = dir - right end
 if down(K.Space) then dir = dir + Vector3.new(0, 1, 0) end
 if down(K.LeftControl) or down(K.C) then dir = dir - Vector3.new(0, 1, 0) end
 if dir.Magnitude < 0.01 then return nil end
 local speed = AR2_safeClamp(tonumber(AR2_CFG.misc.ghostMoveSpeed) or 80, 5, 1000)
 return dir.Unit * (speed / 60)
end
