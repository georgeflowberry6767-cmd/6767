 root.AssemblyLinearVelocity  = Vector3.zero
 root.AssemblyAngularVelocity = Vector3.zero
 end)
 end
 AR2_aaCenter = nil
 AR2_aaOrbitAngle = 0
 end
 if c.look and not suspend then
 local spr
 pcall(function() spr = gc.LookDirectionSpring end)
 if spr then
 local v = CFrame.fromEulerAnglesYXZ(pitch, yaw, 0).LookVector
 pcall(function() spr:StepTo(v, dt or 1 / 60) end)
