 if d <= maxD then
 local sp, vis = cam:WorldToViewportPoint(r.Position)
 if vis then
 local off = (Vector2.new(sp.X, sp.Y)
 - Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)).Magnitude
 local score = d * 0.2 + off
 if score < bestScore then best, bestScore = r.Position, score end
 end
 end
 end
 end
 end
 return best
end
