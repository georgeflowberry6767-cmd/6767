 pcall(function() rec = data[name] end)
 if rec == nil then rec = rawget(data, name) end
 if type(rec) == "table" then
 local slot, t
 pcall(function() slot = rec.EquipSlot end)
 if type(slot) == "string" and slot ~= "" then return slot end
 pcall(function() t = rec.Type end)
 if t == "Hair" or t == "Face" then return t end
 end
 end
 if name:match("^Hair%d") then return "Hair" end
 if name:match("^Face%d") then return "Face" end
