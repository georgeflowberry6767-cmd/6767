function AR2_boxPartList(model, useWhitelist)
 local rec = AR2_boxParts[model]
 local now = os.clock()
 if rec and rec.wl == useWhitelist and (now - rec.at) < 1.5 then return rec.list end
 local list = {}
 if model:IsA("BasePart") then
 list[1] = model
 else
 for _, p in ipairs(model:GetDescendants()) do
 if p:IsA("BasePart") and not p:GetAttribute("ar2_hbe") then
 if (not useWhitelist) or ESP_BODY_WHITELIST[p.Name] then
 list[#list + 1] = p
