function AR2_safeClamp(v, lo, hi)
 v  = tonumber(v)  or 0
 lo = tonumber(lo) or 0
 hi = tonumber(hi) or 0
 if v ~= v then v = lo end
 if lo > hi then return (lo + hi) * 0.5 end
 return math.clamp(v, lo, hi)
end
