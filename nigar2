function AR2_zombieDropNames(cfg)
 local t = type(cfg) == "table" and cfg.CorpseDrops
 if type(t) ~= "table" then return nil end
 local names = {}
 for k, v in pairs(t) do
 local nm
 if type(k) == "string" then nm = k
 elseif type(v) == "string" then nm = v
 elseif type(v) == "table" and type(v.Name) == "string" then nm = v.Name end
 if nm then names[#names + 1] = nm end
 end
 if #names == 0 then return nil end
 table.sort(names)
 return names
end
function AR2_zombieDropList(cfg)
 local t = type(cfg) == "table" and cfg.CorpseDrops
 if type(t) ~= "table" then return nil end
 local list = {}
 for k, v in pairs(t) do
 local nm, chance
 if type(k) == "string" then nm = k end
 if type(v) == "number" then chance = v
 elseif type(v) == "string" then nm = nm or v
 elseif type(v) == "table" then
 nm = nm or (type(v.Name) == "string" and v.Name or nil)
 chance = tonumber(v.Chance) or tonumber(v.Weight) or tonumber(v.Rarity)
 or tonumber(v.Probability)
 end
 if nm then
 list[#list + 1] = { name = nm, chance = chance }
 end
 end
 if #list == 0 then return nil end
 table.sort(list, function(a, b)
 local ca = a.chance or math.huge
 local cb = b.chance or math.huge
 if ca ~= cb then return ca < cb end
 return a.name < b.name
 end)
 return list
end
function AR2_zombieDropText(cfg, maxItems)
 local names = AR2_zombieDropNames(cfg)
 if not names then return nil end
 local parts = {}
 for i = 1, math.min(#names, maxItems or 4) do parts[i] = names[i] end
 local extra = #names - #parts
 return table.concat(parts, ", ") .. (extra > 0 and (" +" .. extra) or "")
end
