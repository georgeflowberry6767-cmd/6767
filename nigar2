 (AR2_lootTypeSeen["<no Type field>"] or 0) + 1
 end
 end
 if ok and fit and inv and type(inv.ItemPickupCheck) == "function" then
 local good, res = pcall(inv.ItemPickupCheck, inv, it)
 if good then ok = res and true or false end
 end
 if ok then plan[#plan + 1] = { item = it, container = c }
